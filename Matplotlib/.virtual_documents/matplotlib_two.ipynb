# Histogram
import numpy as np
import matplotlib.pyplot as plt

np.random.seed(0)

scores = np.random.normal(70, 10 ,100)

plt.hist(scores, color="skyblue", edgecolor="black", bins=5)
plt.ylabel("Of Student")
plt.xlabel("scores")


