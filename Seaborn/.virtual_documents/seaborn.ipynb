import seaborn as sns
import matplotlib.pyplot as plt

sns.set_theme()


sns.get_dataset_names()


tips = sns.load_dataset("tips")
print(tips.head())


sns.relplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="smoker",
    size="size",
    style="smoker"
)


sns.relplot(
    data=tips,
    x="total_bill",
    y="tip",
    kind="line"
)


# Scatter plot

tips = sns.load_dataset("tips")

sns.scatterplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="time"
)


# line plot

flights = sns.load_dataset("flights")

sns.lineplot(
    data=flights,
    x="year",
    y="passengers"
)


# bar plot
sns.barplot(
    data=tips,
    x="day",
    y="tip",
    hue="sex"
)



